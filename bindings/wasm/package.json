{
  "name": "@unsigned/transliterator-wasm",
  "version": "0.1.0",
  "description": "WebAssembly bindings for transliterator",
  "main": "pkg/transliterator_wasm.js",
  "types": "pkg/transliterator_wasm.d.ts",
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "build:nodejs": "wasm-pack build --target nodejs --out-dir pkg-node"
  },
  "keywords": [
    "transliteration",
    "wasm",
    "webassembly",
    "assamese",
    "bengali",
    "hindi",
    "indian-languages"
  ],
  "author": "Unsigned Labs",
  "license": "MIT"
}
