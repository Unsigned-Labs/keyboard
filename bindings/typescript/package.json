{
  "name": "@unsigned/transliterator-native",
  "version": "0.1.0",
  "description": "Native Node.js bindings for transliterator",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "transliterator-node",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node test.js",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "keywords": [
    "transliteration",
    "assamese",
    "bengali",
    "hindi",
    "indian-languages",
    "napi",
    "rust"
  ],
  "author": "Unsigned Labs",
  "license": "MIT",
  "engines": {
    "node": ">= 10"
  }
}
